# .htaccess para la carpeta de doctorfelipecriollo.com en Bluehost (sitio estático nuevo).
RewriteEngine On
RewriteRule ^\.well-known/ - [L]

# Siempre https y sin www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://doctorfelipecriollo.com%{REQUEST_URI} [R=301,L]

# Direcciones del WordPress anterior
RewriteRule ^about/?$ /perfil/ [R=301,L]
RewriteRule ^services/?$ /especialidades/ [R=301,L]
RewriteRule ^contact/?$ /donde-atiendo/ [R=301,L]
RewriteRule ^(hello-world|category/.*|author/.*|wp-login\.php|wp-admin.*)/?$ / [R=301,L]

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Lo que no debe servirse aunque se suba por error
RewriteRule ^(worker|_build|publicacion|\.github|\.git)(/|$) - [F]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=15552000"
  <FilesMatch "\.(woff2|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js|json|html)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
